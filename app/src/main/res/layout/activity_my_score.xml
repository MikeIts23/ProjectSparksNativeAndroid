<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMyScore"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1F">

    <!-- Immagine del giocatore, grande e centrata -->
    <ImageView
        android:id="@+id/imageAvatar"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/logosparks3"
        android:contentDescription="@string/player_avatar_desc"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Guideline al 50% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Card “Modalità 1” con sfondo gradiente -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMode1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/imageAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
        app:layout_constraintWidth_percent="0.40">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_edit_profile"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/combo_chain1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card “Modalità 2” con sfondo gradiente -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMode2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/imageAvatar"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.40">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_edit_profile"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/Colormix1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Punteggio Modalità 1 -->
    <LinearLayout
        android:id="@+id/containerScore1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardMode1"
        app:layout_constraintStart_toStartOf="@id/cardMode1"
        app:layout_constraintEnd_toEndOf="@id/cardMode1">

        <ImageView
            android:id="@+id/iconTrophy1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/trophy_icon"
            android:contentDescription="@string/high_score_trophy"/>

        <TextView
            android:id="@+id/textScore1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="1200"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Punteggio Modalità 2 -->
    <LinearLayout
        android:id="@+id/containerScore2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardMode2"
        app:layout_constraintStart_toStartOf="@id/cardMode2"
        app:layout_constraintEnd_toEndOf="@id/cardMode2">

        <ImageView
            android:id="@+id/iconTrophy2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/trophy_icon"
            android:contentDescription="@string/high_score_trophy"/>

        <TextView
            android:id="@+id/textScore2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="1500"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Bottom navigation -->
    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
