<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutLeaderboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1F"
    tools:context=".LeaderboardActivity">

    <!-- Titolo in alto -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/leaderboard_title"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <!-- Contenitore per i tab (Friends, National, Global) -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#191c2b"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab "Friends" -->
        <FrameLayout
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/tab_friends"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Tab "National" -->
        <FrameLayout
            android:id="@+id/tabNational"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/tab_national"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:visibility="gone"
                android:background="#00cfff" />
        </FrameLayout>

        <!-- Tab "Global" -->
        <FrameLayout
            android:id="@+id/tabGlobal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/tab_global"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:visibility="gone"
                android:background="#00cfff" />
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/viewIndicator"
        android:layout_width="150dp"
        android:layout_height="2dp"
        android:background="#00cfff"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintStart_toStartOf="@id/layoutTabs" />

    <!-- ScrollView per scorrere il contenuto (podio + lista) -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <!-- Contenitore verticale per Podio + Lista  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- RIGA ORIZZONTALE con i primi 3 giocatori (80dp, equidistanti, stessa altezza) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="20dp">

                <!-- 2° posto (sinistra) -->
                <LinearLayout
                    android:id="@+id/layoutSecond"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        android:clipToOutline="true"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:id="@+id/imageSecond"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textSecondName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user234"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSecondScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1200"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 1° posto (al centro, con corona) -->
                <LinearLayout
                    android:id="@+id/layoutFirst"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Corona sopra -->
                    <ImageView
                        android:id="@+id/imageCrown"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="-12dp"
                        android:src="@drawable/crown" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardFirst"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="40dp"
                            android:clipToOutline="true"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp">

                            <ImageView
                                android:id="@+id/imageFirst"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/logosparks3" />
                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/textFirstName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user435"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textFirstScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1500"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 3° posto (destra) -->
                <LinearLayout
                    android:id="@+id/layoutThird"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        android:clipToOutline="true"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:id="@+id/imageThird"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textThirdName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user6887"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textThirdScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1100"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LISTA con 10 utenti (ognuno con ID unici per Nome e Punteggio) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot1Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mario Rossi"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot1Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@mariorossi"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot1Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1000"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 2) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot2Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alessandro T."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot2Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@alext"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot2Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="980"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 3) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot3Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giovanni B."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot3Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@giob"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot3Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="960"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- ... Proseguiamo fino al decimo -->

                <!-- 4) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot4Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot4Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anna Johnson"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot4Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@annaj"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot4Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="920"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 5) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot5Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot5Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Federica G."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot5Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@fedeg"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot5Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="900"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 6) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot6Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot6Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lucas White"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot6Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@lucasw"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot6Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="880"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 7) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot7Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot7Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simone Bruni"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot7Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@simobr"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot7Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="860"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 8) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot8Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot8Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Isabella K."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot8Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@isaK"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot8Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="840"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 9) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot9Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot9Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kevin Chen"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot9Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@kevinch"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot9Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="810"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#191c2b" />

                <!-- 10) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/slot10Image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logosparks3"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlot10Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Martin S."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSlot10Handle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@martins"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSlot10Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="800"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Include della bottom navigation (bottom_nav.xml) -->
    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
