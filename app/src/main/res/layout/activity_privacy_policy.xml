<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPrivacyPolicy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_privacy"
    tools:context=".PrivacyPolicyActivity">

    <ImageView
        android:id="@+id/iconBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="4dp"
        android:src="@drawable/back"
        app:tint="@android:color/white"
        android:contentDescription="@string/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/privacy_title"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/iconBack"
        app:layout_constraintBottom_toBottomOf="@+id/iconBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/iconBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sezione 1 -->
            <TextView
                android:id="@+id/textHeading1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_heading1"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textParagraph1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_paragraph1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sezione 2 -->
            <TextView
                android:id="@+id/textHeading2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_heading2"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textParagraph2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_paragraph2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sezione 3 -->
            <TextView
                android:id="@+id/textHeading3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_heading3"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textParagraph3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_paragraph3"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sezione 4 -->
            <TextView
                android:id="@+id/textHeading4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_heading4"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textParagraph4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_paragraph4"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Sezione 5 -->
            <TextView
                android:id="@+id/textHeading5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_heading5"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textParagraph5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_paragraph5"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
